{
  "name": "secure-messenger-desktop",
  "version": "1.0.0",
  "description": "Secure Messenger Desktop - Chat List + Sync Simulator",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "npm run build:dev && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:dev": "npm run build:main:dev && npm run build:renderer:dev",
    "build:main": "tsc -p tsconfig.main.json",
    "build:main:dev": "tsc -p tsconfig.main.json --sourceMap",
    "build:renderer": "webpack --config webpack.config.js --mode production",
    "build:renderer:dev": "webpack --config webpack.config.js --mode development",
    "watch": "concurrently \"tsc -p tsconfig.main.json -w\" \"webpack --config webpack.config.js --mode development --watch\"",
    "postinstall": "electron-rebuild",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@reduxjs/toolkit": "^2.2.1",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.1.0",
    "input-otp": "^1.4.2",
    "keytar": "^7.9.0",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^18.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.1",
    "react-redux": "^9.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-virtualized-auto-sizer": "^2.0.2",
    "react-window": "^1.8.10",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "ws": "^8.16.0",
    "zod": "^4.3.6"
